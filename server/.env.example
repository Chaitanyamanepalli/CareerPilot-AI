PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/jobportal_pro
JWT_SECRET=your_jwt_secret_here_min_32_chars

# ── Ollama Local AI ────────────────────────────────────────────────────────
# Install Ollama: https://ollama.com
# Pull the model: ollama pull gemma3:4b
# Start the server: ollama serve
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# ── Email Service (Candidate Status Updates, Interview Invites, Password Resets) ──
# Option 1: Gmail (Use 16-character Google App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password
EMAIL_FROM="CareerPilot AI <your_email@gmail.com>"

# Option 2: Custom SMTP (Brevo, SendGrid, Amazon SES, Mailgun)
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USER=your_smtp_login
# EMAIL_PASS=your_smtp_password
# EMAIL_FROM="CareerPilot AI <noreply@yourdomain.com>"

# Option 3: Resend HTTP API
# RESEND_API_KEY=re_your_api_key_here

# ── Optional: Judge0 (RapidAPI) ───────────────────────────────────────────
# If not provided, built-in sandboxed runner executes Python & Node.js locally
# JUDGE0_API_KEY=your_rapidapi_key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# ── Initial Admin Provisioning (Run: npm run setup:admin) ─────────────────
# ADMIN_EMAIL=admin@gmail.com
# ADMIN_PASSWORD=admin@123!

